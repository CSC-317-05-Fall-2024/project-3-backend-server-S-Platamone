<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="icon" href="images/icon.svg">
    <link rel="stylesheet" href="styles.css">
    <script type="module" src="scripts/header.js"></script>
    <script type="module" src="scripts/restaurantCards.js"></script>
</head>
<body>
    <header></header>
    <nav></nav>
    <% let cardID = 1 %>
    <div class="gridCardContainer">
        <% for (let restaurant of restaurantData) { %>
            <div class="gridCard" id="card-<%= cardID %>">
             <img class="gridCardImg" src="<%= restaurant.photo %>">
             <p><%= restaurant.name %></p>
             <p><%= restaurant.address %></p>
             <p><%= restaurant.number %></p>
             <button class="deleteButton" id="<%= cardID %>">X</button>
            </div>
            <% cardID += 1 %>
        <% } %>
    </div>
    <footer></footer>
</body>
</html>